# Copy to deploy/.env on the VPS (gitignored). Full variable list: ../.env.example.

# Passkeys are bound to this hostname. Changing it later invalidates every passkey.
RP_ID=myog.duckdns.org
ORIGIN=https://myog.duckdns.org
RP_NAME=openGym

# The first profile created becomes admin. Create yours right after the first deploy.
FIRST_USER_ADMIN=1
# Then set INVITE_ONLY=1 (and ALLOW_GUEST=0 if you want) and recreate the api container:
#   docker compose -f deploy/docker-compose.yml up -d --force-recreate api
INVITE_ONLY=0

VAPID_SUBJECT=mailto:you@example.com
